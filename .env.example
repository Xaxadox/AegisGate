# Ambiente de Execucao (development, testing, production)
ENVIRONMENT=development

# Configuracoes do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=api_user
DB_PASSWORD=api_password
DB_NAME=fraud_db
# DATABASE_URL=mysql+pymysql://api_user:api_password@localhost:3306/fraud_db

# Configuracoes do Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Seguranca (JWT)
JWT_SECRET_KEY=substitua-por-uma-chave-jwt-segura-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Criptografia em Repouso (Fernet / AES-256)
# Exige chave Base64 URL-safe de 32 bytes.
# Para gerar uma nova chave no terminal: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Tokenizacao Deterministica de Cartoes (HMAC-SHA256 para PCI-DSS e LGPD)
TOKENIZATION_HMAC_SECRET=substitua-por-um-segredo-hmac-forte-em-producao

# MaxMind GeoIP Path
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
